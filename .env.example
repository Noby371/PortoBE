# Koneksi database (Docker PostgreSQL di port 5434)
DATABASE_URL="postgres://postgres:postgres@localhost:5434/portofolio?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:5434/portofolio_shadow?sslmode=disable"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── API ──────────────────────────────────────────────────────────────────────
API_PREFIX=/api/v1

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Ganti dengan secret acak:  openssl rand -hex 32
JWT_SECRET=ganti-dengan-secret-acak
